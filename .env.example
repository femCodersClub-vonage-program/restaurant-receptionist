# Local PostgreSQL configuration for Docker Compose and the backend local profile.
# Copy this file to .env and replace POSTGRES_PASSWORD with a local-only value.
POSTGRES_DB=restaurant_receptionist
POSTGRES_USER=restaurant_receptionist
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432

# Optional inbound Vonage webhook verification. Configure only in the receiving backend's environment.
VONAGE_WEBHOOKS_ENABLED=false
VONAGE_API_KEY=
VONAGE_SIGNATURE_SECRET=
VONAGE_APPLICATION_ID=
